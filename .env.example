# LogiShift Frontend Environment Variables
# Copy this file to .env.local and fill in actual values

# API Configuration
# Backend API base URL (without trailing slash)
VITE_API_URL=http://localhost:3000/api/v1

# Static files base URL (for photo uploads)
VITE_STATIC_URL=http://localhost:3000

# Public analytics counter. Leave unset until a numeric Yandex Metrika ID exists.
VITE_YANDEX_METRIKA_ID=<COUNTER_ID>
